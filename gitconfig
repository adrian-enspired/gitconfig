# This is Git's per-user configuration file.

[include]
	path = ~/.config/git/at-aliases.gitconfig

[user]
	name =
	email =
	signingkey =

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true
	#missingCommitsCheck = true
	updateRefs = true

[rerere]
	enabled = true
	autoupdate = true

[branch]
	sort = -authordate

[tag]
	sort = version:refname

[init]
	defaultBranch = master

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true # i(ndex)..w(orking)  vs  a..b
	renames = copies
	context = 3
	interHunkContext = 10

[commit]
	gpgSign = true

[help]
	autocorrect = prompt

[at "ticket"]
	# default ticket prefix for a bare number: `git dk 12345` -> COM-12345
	# override per call with AT_TPREFIX=
	prefix =
	# prefixes belonging to another tracker - a retired one, or one git-at does
	# not talk to. Keys matching these are recognised, linked and put in
	# trailers, but never looked up or transitioned. Empty means nothing is
	# ignored. Repeat the key, or separate with commas or spaces:
	#   ignored-prefixes = MAD- MADRR- NXERR-
	# override per call with AT_IGNORED_PREFIXES=
	ignored-prefixes =
	# where those keys live, as a template taking the key. Without it they are
	# named but not linked:
	#   ignored-url = https://example.atlassian.net/browse/%s
	ignored-url =

[at "linear"]
	# a linear personal api key. keep this out of any repo: set it in your own
	# global config, not here. override per call with AT_LINEAR_APIKEY=
	apikey =
	# workspace slug, used to build ticket links in PR bodies
	workspace =

[at "llm"]
	# any command taking a prompt on stdin and writing text to stdout:
	#   claude -p --model haiku --allowed-tools= --setting-sources=
	#   ollama run qwen3:4b
	# the two empty flags matter: `claude -p` is an agent, and left with its
	# tools and settings it will go and look at the repo instead of answering.
	# per feature: at.llm.commitcommand / prcommand / slugcommand
	command =
	# seconds before the model is given up on and the command carries on without it
	timeout = 60

[at "commit"]
	# the trailer `c --cc` adds. attributes the code, not the message
	coauthor =

[at "status"]
	# the ticket status each command moves to; empty means leave it alone
	dk = In Progress
	uk = In Progress
	r = In Review
	rd = In Progress
	rr = In Review
	urr = In Progress

[at "patch"]
	# base directory for the patch commands (pf / pb / pall / pw).
	# patches land in <at.patch.dir>/<repo>/<branch>/<command name>
	# override per call with AT_PATCH_DIR=
	dir = ~/patches
